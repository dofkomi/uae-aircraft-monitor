# ============================================================
# إعدادات بوت مراقبة الطائرات — بيانات ADS-B العامة المجانية
# انسخ هذا الملف إلى .env ثم عدّل القيم
# ============================================================

# --- تليجرام (إلزامي) ---
# احصل على التوكن من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# معرّفات المحادثات المسموح لها (أرقام، مفصولة بفواصل). اتركها فارغة للسماح للجميع.
TELEGRAM_CHAT_IDS=123456789,987654321

# --- منطقة المراقبة (الإمارات تقريباً) ---
UAE_LAMIN=22.5
UAE_LAMAX=26.2
UAE_LOMIN=51.5
UAE_LOMAX=56.5
# مركز الدائرة البديلة (تستخدمها مصادر مثل adsb.lol)
UAE_CENTER_LAT=24.0
UAE_CENTER_LON=54.0
UAE_RADIUS_NM=220

# --- التوقيت ---
POLL_INTERVAL_SECONDS=120          # كل دقيقتين جلب البيانات
REPORT_INTERVAL_MINUTES=60         # إرسال التقرير كل ساعة
SIGNAL_LOSS_MINUTES=20             # مدة الغياب قبل تسجيل حدث فقدان إشارة
MAX_REPORT_AIRCRAFT=20             # أقصى عدد طائرات مذكورة بالتقرير

# --- مصادر البيانات المجانية ---
USE_ADSBLOL=1                      # api.adsb.lol — مجاني بلا مفتاح (الأفضل)
USE_OPENSKY=1                      # opensky-network.org — مجاني بحساب اختياري

# OpenSky اختياري: أنشئ حساباً مجانياً ثم API client من صفحة الحساب
# https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- تحديد الدولة التي انقطع فيها الإشارة والمطارات ---
USE_GEOCODING=1                    # Nominatim (OpenStreetMap) — مجاني بلا مفتاح
NOMINATIM_USER_AGENT=uae-aircraft-monitor/1.0 (research)
USE_OFFLINE_COUNTRY=1              # تحديد الدولة محلياً من حدود Natural Earth (بلا شبكة)
COUNTRIES_GEOJSON_PATH=data/countries.geojson
AIRPORTS_CACHE_PATH=data/airports.csv   # تُحمّل مرة واحدة من OurAirports (مجاني)

# --- كشف الهبوط وتغيّر الوجهة ---
LANDING_MAX_KM=25                  # أقصى مسافة من المطار لاعتباره مطار الهبوط
LANDING_ALT_FT=1200                # ارتفاع الهبوط
LANDING_SPEED_KTS=80               # سرعة الهبوط
MIN_LEG_MINUTES=30                 # أقل زمن بين هبوطين لاعتبارهما رحلة جديدة

# --- تتبّع عالمي لطائرات بعينها (لمتابعة الهبوط خارج الإمارات مثل روما ← نجامينا) ---
USE_WATCHLIST=1                    # استعلام OpenSky بـ ICAO24 (رصيد واحد لكل طلب)
WATCHLIST_INTERVAL_SECONDS=300     # كل 5 دقائق (400 رصيد/يوم تكفي ~48 طلباً)
WATCHLIST_MAX=20                   # أقصى عدد طائرات في القائمة
WATCHLIST_DYNAMIC=1                # إضافة الطائرات الإماراتية المرصودة تلقائياً

# طائرات إماراتية إضافية بمعرف ICAO24 (اختياري، مفصولة بفواصل) — تُتابع صراحةً
# مثال: UAE_WATCH_ICAO24=8960d1,8960d2
UAE_WATCH_ICAO24=

# --- قاعدة البيانات المحلية ---
DB_PATH=data/aircraft.db

# --- الدولة القريبة (لأحداث الانقطاع فوق المياه) ---
# إن كان آخر موقع فوق المياه، تُذكر أقرب دولة ضمن هذه المسافة (كم)
NEAREST_COUNTRY_MAX_KM=200

# --- إثراء OSINT مجاني (بلا مفاتيح ولا تسجيل) ---
OSINT_ENABLED=1                    # adsbdb (المسار) + adsb.lol (البث العالمي)
OSINT_MAX_ROUTES_PER_POLL=12       # حد الطلبات لكل دورة جلب

# --- الدراسة التحليلية بالذكاء الاصطناعي (نماذج مجانية) ---
# ضع مفتاحاً واحداً فقط — يُكتشف المزوّد تلقائياً بحسب المفتاح:
#   GEMINI_API_KEY      ← https://aistudio.google.com/apikey   (طبقة مجانية)
#   GROQ_API_KEY        ← https://console.groq.com/keys        (طبقة مجانية)
#   OPENROUTER_API_KEY  ← https://openrouter.ai/keys           (طبقة مجانية)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_ENABLED=1
# both = دراسة تحليلية + التقرير المفصّل | analysis = الدراسة وحدها | off = التفاصيل فقط
AI_REPORT_MODE=both
# فرض مزوّد معيّن (اختياري): gemini | groq | openrouter | custom
# AI_PROVIDER=
# فرض اسم نموذج معيّن (اختياري) — بدونه يُكتشف تلقائياً من قائمة النماذج المتاحة
# AI_MODEL=
# أي خدمة متوافقة مع OpenAI (اختياري، يُستخدم مع AI_PROVIDER=custom)
# AI_BASE_URL=https://example.com/v1
# AI_API_KEY=
AI_MAX_TOKENS=4000
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.3
